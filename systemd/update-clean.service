[Unit]
Description=System update and cleanup (update-clean)
Documentation=https://github.com/wbharris/debian_ubuntu_update_clean
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/update-clean.sh
Nice=10
IOSchedulingClass=best-effort
# Do not auto-reboot from the unit; set REBOOT_IF_REQUIRED in config only if you mean it

[Install]
WantedBy=multi-user.target